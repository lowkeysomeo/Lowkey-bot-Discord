# Tệp phục vụ gỡ lỗi
*.pdb

# Thư viện động đã biên dịch
*.so
*.dylib
*.dll
*.so.*

# Tệp mô-đun Fortran
*.mod
*.smod

# Thư viện tĩnh đã biên dịch
*.lai
*.la
*.a
*.lib

# Tệp thực thi
*.exe
*.out
*.app

# Thư mục kết quả biên dịch
build/
Build/
build-*/

# Tệp do CMake tạo
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Tệp tạm
*.tmp
*.log
*.bak
*.swp

# Thư viện do vcpkg cài
vcpkg_installed/

# Thông tin gỡ lỗi
*.dwo

